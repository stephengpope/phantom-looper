{
  "name": "phantom-backend-sdk",
  "version": "0.1.0",
  "description": "The backend half of phantom-agent-sdk: PhantomBackend, the services, tables, API and the doors user space extends them through.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/storage/schema.d.ts",
      "import": "./dist/storage/schema.js"
    },
    "./git": {
      "types": "./dist/git/Git.d.ts",
      "import": "./dist/git/Git.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/agents/models-snapshot.json dist/agents/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "phantom-client-sdk": "*",
    "drizzle-orm": "0.38.4",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "ulid": "2.4.0",
    "fastify": "5.12.1",
    "dockerode": "5.0.1",
    "tar-stream": "2.2.0",
    "@parcel/watcher": "2.6.0",
    "croner": "10.0.1",
    "postgres-array": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "undici": "8.10.0",
    "ai": "7.0.73",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "*",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "@types/pg": "8.23.1",
    "@types/dockerode": "4.0.1",
    "@types/tar-stream": "2.2.3"
  }
}
