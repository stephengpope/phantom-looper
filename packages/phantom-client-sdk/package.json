{
  "name": "phantom-client-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The agent runtime for a phantom-backend: an Agent base class with the turn, the shared append-only transcript, the session lock, model resolution, billing, and the server’s tools over the API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transcript": {
      "types": "./dist/transcript.d.ts",
      "import": "./dist/transcript.js"
    },
    "./systemPrompt": {
      "types": "./dist/systemPrompt.d.ts",
      "import": "./dist/systemPrompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "*",
    "@ai-sdk/deepseek": "*",
    "@ai-sdk/google": "*",
    "@ai-sdk/groq": "*",
    "@ai-sdk/mistral": "*",
    "@ai-sdk/moonshotai": "*",
    "@ai-sdk/openai": "*",
    "@ai-sdk/openai-compatible": "*",
    "@ai-sdk/provider": "*",
    "@ai-sdk/xai": "*",
    "@openai-oauth/core": "*",
    "ulid": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "ai": "*",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
