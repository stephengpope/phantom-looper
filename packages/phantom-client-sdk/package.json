{
  "name": "phantom-client-sdk",
  "version": "0.1.0",
  "description": "Build and run agents against a phantom-backend: frozen prompts, tool kits, an append-only transcript, one turn runner.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "ai": ">=7.0.0",
    "zod": ">=4.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.40",
    "@ai-sdk/deepseek": "3.0.39",
    "@ai-sdk/google": "4.0.49",
    "@ai-sdk/groq": "4.0.37",
    "@ai-sdk/mistral": "4.0.39",
    "@ai-sdk/moonshotai": "3.0.45",
    "@ai-sdk/openai": "4.0.45",
    "@ai-sdk/openai-compatible": "3.0.34",
    "@ai-sdk/provider": "*",
    "@ai-sdk/xai": "4.0.54",
    "@openai-oauth/core": "2.0.0",
    "@openai-oauth/local": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "ai": "7.0.73",
    "eslint": "10.11.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "zod": "4.4.3"
  }
}
