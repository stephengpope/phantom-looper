# The backend this host runs workspaces for.
BACKEND_URL=https://phantom.example.com
# The service role key (ph_service_role_…): a SHARED runner, any workspace may land here.
# Your own user role key (ph_user_role_…): YOUR host, for your workspaces alone.
BACKEND_KEY=
# A label people see. Empty: the container's hostname.
HOST_NAME=
# A backend on its own CA (BACKEND_TLS=internal): its root certificate, PEM, one line with \n.
BACKEND_CA=
# The release to run. Must match the backend's (one SDK version). An upgrade
# from the backend rewrites this line.
BACKEND_TAG=latest
# This directory's absolute path — the updater's helper mounts it to recreate
# the stack on an upgrade.
RUNNER_DIR=/opt/phantom-runner
# The upgrade helper container's name: unique per stack on this Docker daemon.
HELPER_NAME=phantom-update-run-runner
