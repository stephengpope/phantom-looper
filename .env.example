# Everything here is boot-and-connect only. All behavior settings live in the
# database and are managed over the API (GET/PATCH/DELETE /settings).
# The bootstrap superuser's. Boot creates the `migrator` and `backend` roles
# with it and hangs up; the process runs as `backend`.
DATABASE_URL=postgres://superuser:superuser@localhost:5432/phantom
WORKSPACE_ROOT_PATH=/workspaces
PORT=8080
# At least 32 characters — the server refuses to boot on a shorter one.
#   openssl rand -hex 24
API_KEY=
# 32 bytes, base64. Boot-critical: without it the credentials table is unreadable.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# Set, sign-in is on: people, organizations, invitations, API keys (/api/auth,
# docs/multi-user.md). 32+ characters. Empty: off.
#   openssl rand -hex 24
AUTH_SECRET=
# Browser apps on another origin that may sign in here (CORS with credentials),
# comma-separated: https://app.example.com,https://admin.example.com
AUTH_TRUSTED_ORIGINS=
# Beside the magic link: 1 for email + password sign-in; a GitHub OAuth app
# (callback https://<address>/api/auth/callback/github) for GitHub sign-in.
AUTH_PASSWORD=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Docker daemon for workspace containers. Unset auto-detects the local socket;
# compose sets tcp://docker-proxy:2375.
DOCKER_HOST=
# Where POST /update drops a release tag for the updater sidecar. Compose sets
# /trigger (a shared volume); unset, the route answers 503 updater_unavailable.
UPDATE_TRIGGER_DIR=
# Provider API keys are NOT environment variables. They live in the database
# as credentials — /keys in the cli, or PATCH /settings {"anthropic_api_key": ...}
# — one key per provider, one place to set it. A provider with no key stored
# fails with that message; nothing falls back to the environment.

# ── compose-only (read by docker-compose.yml, not by the server) ─────────────
# POSTGRES_USER=superuser  the bootstrap superuser (default phantom: what installs from before carry)
# POSTGRES_PASSWORD=       its password (interpolated into DATABASE_URL)
# BACKEND_PORT=8080 localhost port the api is published on
# BACKEND_API_IMAGE= / BACKEND_SESSION_IMAGE=  test hooks: point at
#                          locally built images instead of ghcr.io
# On a server these are written by scripts/install.sh:
# BACKEND_ADDRESS=  domain or public IP caddy serves (Let's Encrypt for either)
# BACKEND_TLS=public   or `internal` for Caddy's own CA on a private address
# BACKEND_CERT_EMAIL=  Let's Encrypt expiry warnings (optional)
# BACKEND_DIR=/opt/phantom-looper   install dir, bind-mounted into the updater
# BACKEND_TAG=      release pin set by updater/apply.sh; empty = latest
# COMPOSE_PROFILES=https   turns caddy on
