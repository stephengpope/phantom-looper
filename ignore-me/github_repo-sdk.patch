diff --git a/packages/backend/src/storage/sdkSettings.test.ts b/packages/backend/src/storage/sdkSettings.test.ts
new file mode 100644
index 0000000..1593126
--- /dev/null
+++ b/packages/backend/src/storage/sdkSettings.test.ts
@@ -0,0 +1,23 @@
+// The github_repo setting's validator: what a value must look like to be
+// the repo new projects land on. Run: npm test (tsx --test) in this package.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { sdkSettings } from './sdkSettings.js';
+
+const githubRepo = sdkSettings({ sessionImageTag: 'latest' }).find((def) => def.key === 'github_repo')!;
+
+test('github_repo: overridable by an organization, a user, a project', () => {
+  assert.deepEqual(githubRepo.overridableAt, ['organization', 'user', 'project']);
+  assert.equal(githubRepo.default, null);
+});
+
+test('github_repo: owner/name or a GitHub URL; a bare name has no owner to clone from', () => {
+  const check = githubRepo.check!;
+  assert.equal(check('acme/app'), null);
+  assert.equal(check('https://github.com/acme/app'), null);
+  assert.equal(check('https://github.com/acme/app.git'), null);
+  assert.match(check('app')!, /owner\/name/);
+  assert.match(check('https://gitlab.com/acme/app')!, /github\.com/);
+  assert.match(check('https://user:pat@github.com/acme/app')!, /credentials/);
+  assert.match(check('not a repo')!, /GitHub URL/);
+});
