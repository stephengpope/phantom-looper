new file mode 100644
index 0000000..c756980
--- /dev/null
+++ b/packages/backend/migrations/067_projects_share_repos.sql
@@ -0,0 +1,7 @@
+-- Several projects may be on one repository: the `github_repo` setting
+-- puts every new project on a shared repo unless told otherwise, so a
+-- board per team, per customer, per workstream on the same code is the
+-- normal case. Branches are named by workspace id and never collide; the
+-- clone pool is keyed by repo and branch, so they share warm clones.
+alter table phantom_agent_sdk.projects drop constraint projects_organization_owner_name_key;
+create index projects_organization_owner_name_idx on phantom_agent_sdk.projects (organization_id, owner, name);
