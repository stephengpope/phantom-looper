{
  "name": "phantom-looper",
  "version": "0.1.28",
  "description": "phantom-looper — a terminal coding agent with a kanban-driven supervisor loop",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/phantom-backend/index.js",
    "keys": "tsx --tsconfig phantom-cli/tsconfig.json phantom-cli/keys.tsx",
    "typecheck": "tsc --noEmit && tsc -p phantom-cli",
    "models:snapshot": "tsx scripts/models-snapshot.ts",
    "phantom-cli": "NODE_ENV=production tsx --tsconfig phantom-cli/tsconfig.json phantom-cli/index.tsx",
    "phantom-backend": "tsx phantom-backend/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/deepseek": "^3.0.39",
    "@ai-sdk/google": "^4.0.49",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/mistral": "^4.0.39",
    "@ai-sdk/moonshotai": "^3.0.45",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/openai-compatible": "^3.0.34",
    "@ai-sdk/xai": "^4.0.54",
    "@clack/prompts": "^1.7.0",
    "@fastify/http-proxy": "^11.6.1",
    "@parcel/watcher": "^2.6.0",
    "@xterm/headless": "^6.0.0",
    "ai": "^7.0.73",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "jose": "^6.2.9",
    "mdast-util-from-markdown": "^2.0.3",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "string-width": "^7.2.0",
    "tar-stream": "^2.2.0",
    "ulid": "^2.3.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/tar-stream": "^2.2.3",
    "chalk": "^5.6.2",
    "esbuild": "^0.28.2",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
