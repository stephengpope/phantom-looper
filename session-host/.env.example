# The backend this host runs workspaces for.
BACKEND_URL=https://phantom.example.com
# The root API key: a SHARED host, any workspace may land here.
# Your own API key: YOUR host, for your workspaces alone.
BACKEND_KEY=
# A label people see. Empty: the container's hostname.
HOST_NAME=
# A backend on its own CA (BACKEND_TLS=internal): its root certificate, PEM, one line with \n.
BACKEND_CA=
# The release to run. Must match the backend's (one SDK version).
BACKEND_TAG=latest
